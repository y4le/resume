{
  "name": "resume",
  "version": "1.0.0",
  "description": "Yale Thomas's web and PDF resume",
  "main": "./src/js/app.js",
  "author": "Yale Thomas",
  "license": "MIT",
  "scripts": {
    "build": "npx webpack --mode production",
    "pdf": "node ./src/pdf/makePdf.js",
